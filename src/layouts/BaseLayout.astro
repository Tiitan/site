---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = "Titan - game developer",
  description = "Titan builds real-time destruction systems and gameplay tooling focused on runtime geometry, performance, and reliable content workflows.",
  image = "/images/window-fracture-cover.png",
  noindex = false
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://titan.nofl.uk").toString();
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Titan" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site ?? "https://titan.nofl.uk").toString()} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site ?? "https://titan.nofl.uk").toString()} />

    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const isDark = stored ? stored === "dark" : prefersDark;
          document.documentElement.classList.toggle("dark", isDark);
        } catch {
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", prefersDark);
        }
      })();
    </script>

    <title>{title}</title>
  </head>
  <body class="h-full">
    <a
      href="#main-content"
      class="sr-only left-4 top-4 z-50 rounded-md bg-cyan-600 px-3 py-2 font-medium text-white focus:not-sr-only focus:absolute"
    >
      Skip to content
    </a>

    <div class="relative flex min-h-screen flex-col">
      <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-80 bg-gradient-to-b from-cyan-100 to-transparent dark:from-cyan-950/40"></div>
      <Header currentPath={Astro.url.pathname} />
      <main id="main-content" class="mx-auto w-full max-w-6xl flex-1 px-4 pb-16 pt-10 sm:px-6 lg:px-8">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
