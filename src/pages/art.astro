---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getArtstationItems, type ArtItem } from "../lib/artstation";

const artstationUrl = "https://titan_8190.artstation.com/";

let items: ArtItem[] = [];
let hasLoadError = false;

try {
  items = await getArtstationItems(12);
} catch (error) {
  hasLoadError = true;
  console.error("Failed to load ArtStation RSS feed:", error);
}

const hasItems = items.length > 0;

const formatDate = (value: Date | null) =>
  value
    ? new Intl.DateTimeFormat("en-US", {
        year: "numeric",
        month: "short",
        day: "numeric"
      }).format(value)
    : "Unknown date";
---

<BaseLayout
  title="Art | Titan"
  description="Art portfolio synced from Titan's ArtStation feed."
  image="/images/mecha-signature.jpg"
>
  <section class="surface">
    <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-cyan-700 dark:text-cyan-300">Art</p>
    <h1 class="text-3xl font-extrabold sm:text-4xl">ArtStation Portfolio</h1>
    <p class="mt-4 max-w-3xl text-slate-700 dark:text-slate-300">
        This page aggregates my latest ArtStation work.
    </p>
    <p class="mt-4 max-w-3xl text-slate-700 dark:text-slate-300">
      I’m a hobbyist technical artist focused on real-time VFX, shaders, and procedural workflows. Most pieces are experiments exploring rendering techniques, simulation, and tooling—often bridging code and visuals. I also showcase some modest 3D models.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a class="button-primary" href={artstationUrl} target="_blank" rel="noreferrer noopener">
        Open ArtStation Profile
      </a>
    </div>
  </section>

  {
    hasItems && (
      <section class="mt-10">
        <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
          {items.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noreferrer noopener"
              class="surface group flex h-full flex-col gap-4 transition hover:-translate-y-0.5 hover:border-cyan-300 hover:shadow-md dark:hover:border-cyan-700"
              aria-label={`Open ${item.title} on ArtStation (new tab)`}
            >
              {item.videoUrl ? (
                <video
                  class="h-48 w-full rounded-xl border border-slate-200 object-cover dark:border-slate-700"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  poster={item.imageUrl ?? undefined}
                >
                  <source src={item.videoUrl} type="video/mp4" />
                </video>
              ) : item.imageUrl ? (
                <img
                  src={item.imageUrl}
                  alt={`${item.title} preview`}
                  class="h-48 w-full rounded-xl border border-slate-200 object-cover dark:border-slate-700"
                  loading="lazy"
                />
              ) : (
                <div class="flex h-48 items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-100 text-sm font-medium text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400">
                  No preview image
                </div>
              )}

              <div class="flex flex-1 flex-col gap-3">
                <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100">{item.title}</h2>
                <time class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">
                  {formatDate(item.publishedAt)}
                </time>
                <p class="text-sm text-slate-700 dark:text-slate-300">{item.excerpt}</p>
                <span class="mt-auto text-sm font-semibold text-cyan-700 dark:text-cyan-300">View on ArtStation</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    !hasItems && (
      <section class="surface mt-10">
        <h2 class="text-2xl font-bold">Art feed unavailable</h2>
        <p class="mt-3 text-slate-700 dark:text-slate-300">
          Unable to load latest artworks right now.
          {hasLoadError && " Please try again on a later deploy."}
        </p>
        <a class="button-secondary mt-5" href={artstationUrl} target="_blank" rel="noreferrer noopener">
          Visit ArtStation
        </a>
      </section>
    )
  }
</BaseLayout>
