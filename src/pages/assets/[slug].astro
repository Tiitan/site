---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/Tag.astro";

export async function getStaticPaths() {
  const assets = await getCollection("assets");
  return assets.map((asset) => ({
    params: { slug: asset.slug },
    props: { asset }
  }));
}

const { asset } = Astro.props;
const { Content } = await render(asset);
const storeUrl = asset.data.storeUrl;
const storeLabel = asset.data.storeLabel || "View in store";
---

<BaseLayout
  title={`${asset.data.title} | Assets | Titan`}
  description={asset.data.description}
>
  <article class="space-y-8">
    <header class="surface">
      <div class="grid gap-6 lg:grid-cols-[1fr_280px] lg:items-start">
        <div>
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-cyan-700 dark:text-cyan-300">Asset detail</p>
          <h1 class="text-3xl font-extrabold sm:text-4xl">{asset.data.title}</h1>
          <p class="mt-4 max-w-3xl text-slate-700 dark:text-slate-300">{asset.data.description}</p>

          <div class="mt-6 flex flex-wrap gap-2">
            {asset.data.tags.map((tag: string) => <Tag label={tag} />)}
          </div>

          {
            storeUrl && (
              <div class="mt-8 flex justify-center">
                <a
                  href={storeUrl}
                  target="_blank"
                  rel="noreferrer noopener"
                  class="inline-flex w-full max-w-md items-center justify-center rounded-xl bg-cyan-600 px-8 py-4 text-lg font-semibold text-white shadow-sm transition hover:bg-cyan-500 sm:w-auto sm:min-w-[320px]"
                >
                  {storeLabel}
                </a>
              </div>
            )
          }
        </div>

        {
          asset.data.cardImage && (
            <img
              src={asset.data.cardImage}
              alt={`${asset.data.title} card image`}
              class="w-full rounded-xl border border-slate-200 object-cover dark:border-slate-700"
              loading="lazy"
            />
          )
        }
      </div>
    </header>

    <div
      class:list={[
        "surface",
        "space-y-6",
        "[&_h2]:text-2xl [&_h2]:font-bold",
        "[&_h3]:text-xl [&_h3]:font-semibold",
        "[&_p]:leading-7 [&_p]:text-slate-700 dark:[&_p]:text-slate-300",
        "[&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5",
        "[&_li]:text-slate-700 dark:[&_li]:text-slate-300",
        "[&_table]:w-full [&_table]:border-collapse [&_table]:overflow-hidden [&_table]:rounded-xl [&_table]:border [&_table]:border-slate-200 dark:[&_table]:border-slate-700",
        "[&_th]:bg-slate-100 [&_th]:px-3 [&_th]:py-2 [&_th]:text-left [&_th]:text-sm [&_th]:font-semibold dark:[&_th]:bg-slate-800",
        "[&_td]:border-t [&_td]:border-slate-200 [&_td]:px-3 [&_td]:py-2 [&_td]:text-sm dark:[&_td]:border-slate-700",
        "[&_a]:text-cyan-700 [&_a]:underline-offset-4 hover:[&_a]:underline dark:[&_a]:text-cyan-300",
        "[&_img]:w-full [&_img]:rounded-xl [&_img]:border [&_img]:border-slate-200 dark:[&_img]:border-slate-700",
        "[&_iframe]:aspect-video [&_iframe]:w-full [&_iframe]:rounded-xl [&_iframe]:border [&_iframe]:border-slate-200 dark:[&_iframe]:border-slate-700"
      ]}
    >
      <Content />
    </div>
  </article>
</BaseLayout>
