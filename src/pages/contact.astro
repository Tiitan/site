---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | Titan"
  description="Contact Titan for collaboration and support."
>
  <section class="max-w-3xl">
    <h1 class="text-3xl font-extrabold sm:text-4xl">Contact</h1>
    <p class="mt-4 text-slate-700 dark:text-slate-300">
      For collaboration, or consulting, the fastest route is email.
    </p>
    <p class="mt-4 text-slate-700 dark:text-slate-300">
      For support, open a github issue or reach out on Discord.
    </p>
  </section>

  <section class="surface mt-8 max-w-3xl">
    <dl class="space-y-4">
      <div>
        <dt class="text-sm font-semibold text-slate-900 dark:text-slate-100">Email</dt>
        <a class="text-sm" href="mailto:florian.noirbent@gmail.com">florian.noirbent@gmail.com</a>
      </div>

      <div>
        <dt class="text-sm font-semibold text-slate-900 dark:text-slate-100">LinkedIn</dt>
        <dd class="text-sm">
          <a href="https://www.linkedin.com/in/florian-noirbent/" target="_blank" rel="noreferrer noopener">
            linkedin.com/in/florian-noirbent
          </a>
        </dd>
      </div>

      <div>
        <dt class="text-sm font-semibold text-slate-900 dark:text-slate-100">GitHub</dt>
        <dd class="text-sm">
          <a href="https://github.com/Tiitan" target="_blank" rel="noreferrer noopener">github.com/Tiitan</a>
        </dd>
      </div>

      <div>
        <dt class="text-sm font-semibold text-slate-900 dark:text-slate-100">Discord</dt>
        <dd class="text-sm">
          <a href="https://discordapp.com/users/titan8190" target="_blank" rel="noreferrer noopener">titan8190</a>
        </dd>
      </div>
    </dl>
  </section>
</BaseLayout>
