---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameCard from "../../components/GameCard.astro";

const games = (await getCollection("games")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  year: "numeric"
});
---

<BaseLayout title="Games | Titan" description="Game projects shipped and prototyped by Titan.">
  <section>
    <h1 class="text-3xl font-extrabold sm:text-4xl">Games</h1>
    <p class="mt-4 max-w-3xl text-slate-700 dark:text-slate-300">
      A selection of mobile and student game projects spanning arcade, runner, puzzle, and experimental multiplayer prototypes. Developed independently and with SupremApp. Contractual work is not included.
    </p>
    <p class="mt-4 max-w-3xl text-slate-700 dark:text-slate-300">
      Contractual work is not included here.
    </p>
  </section>

  <section class="mt-8">
    <div class="grid gap-5 md:grid-cols-2">
      {
        games.map((game) => (
          <GameCard
            title={game.data.title}
            description={game.data.description}
            image={game.data.cardImage}
            href={`/games/${game.slug}`}
            dateLabel={dateFormatter.format(game.data.date)}
            engine={game.data.engine}
            platforms={game.data.platforms}
            status={game.data.status}
            highlighted={game.data.highlighted}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
