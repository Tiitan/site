---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const assets = await getCollection("assets");
const featured = assets
  .filter((asset) => asset.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Titan" description="Home of Titan's portfolio, featured assets.">
  <section class="grid gap-6 lg:grid-cols-[1.35fr_0.65fr] lg:items-stretch">
    <div class="surface flex h-full flex-col justify-center">
      <h1 class="text-4xl font-bold">
        Real-time Systems & Technical Game Development
      </h1>

      <p class="mt-4 max-w-2xl text-slate-700 dark:text-slate-300">
        I build gameplay systems, rendering pipelines, and procedural tools -
        from production backend systems to real-time VFX and physics-driven mechanics.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a class="button-primary" href="/assets">View Assets</a>
        <a class="button-secondary" href="/contact">Contact</a>
      </div>
    </div>

    <aside class="surface p-2">
      <img
        src="/images/mecha-signature.jpg"
        alt="Titan signature mecha artwork"
        class="h-full min-h-[280px] w-full rounded-xl border border-slate-200 object-cover dark:border-slate-700"
        loading="lazy"
      />
    </aside>
  </section>

  <section class="mt-12">
    <div class="mb-6 flex items-center justify-between gap-4">
      <h2 class="text-2xl font-bold">Featured Assets</h2>
      <a class="text-sm font-semibold text-cyan-700 hover:underline dark:text-cyan-300" href="/assets">
        See all assets
      </a>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      {
        featured.map((asset) => (
          <ProjectCard
            title={asset.data.title}
            description={asset.data.description}
            image={asset.data.cardImage}
            tags={asset.data.tags}
            href={`/assets/${asset.slug}`}
            status={asset.data.status}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
