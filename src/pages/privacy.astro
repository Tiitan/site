---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Privacy | Titan" description="Privacy notice for titan.nofl.uk.">
  <section class="max-w-3xl">
    <h1 class="text-3xl font-extrabold sm:text-4xl">Privacy</h1>
    <p class="mt-4 text-slate-700 dark:text-slate-300">
      This site is intentionally minimal and privacy-first.
    </p>
  </section>

  <section class="surface mt-8 max-w-3xl">
    <ul class="list-disc space-y-3 pl-5 text-sm text-slate-700 dark:text-slate-300">
      <li>No tracking or analytics are enabled by default.</li>
      <li>Theme preference is stored in <code>localStorage</code> on your device.</li>
      <li>Any data you share is through the email you choose to send.</li>
    </ul>
  </section>
</BaseLayout>
