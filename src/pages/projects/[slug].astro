---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/Tag.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const hasUnreal = project.data.engines.unreal.trim().length > 0;
const hasAssetStore = Boolean(project.data.links.assetStore);
const isWindowFracture = project.slug === "window-fracture";
---

<BaseLayout
  title={`${project.data.title} | Projects | Titan`}
  description={project.data.description}
  image="/images/window-fracture-cover.png"
>
  <article class="space-y-8">
    <header class="surface">
      <div class="grid gap-6 lg:grid-cols-[1fr_280px] lg:items-start">
        <div>
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-cyan-700 dark:text-cyan-300">Project detail</p>
          <h1 class="text-3xl font-extrabold sm:text-4xl">{project.data.title}</h1>
          <p class="mt-4 max-w-3xl text-slate-700 dark:text-slate-300">{project.data.description}</p>

          <div class="mt-6 flex flex-wrap gap-2">
            {project.data.tags.map((tag: string) => <Tag label={tag} />)}
          </div>

          <dl class="mt-6 grid gap-4 text-sm sm:grid-cols-3">
            <div>
              <dt class="font-semibold text-slate-900 dark:text-slate-100">Status</dt>
              <dd class="text-slate-700 dark:text-slate-300">{project.data.status}</dd>
            </div>
            <div>
              <dt class="font-semibold text-slate-900 dark:text-slate-100">Unity</dt>
              <dd class="text-slate-700 dark:text-slate-300">{project.data.engines.unity}</dd>
            </div>
            {
              hasUnreal && (
                <div>
                  <dt class="font-semibold text-slate-900 dark:text-slate-100">Unreal</dt>
                  <dd class="text-slate-700 dark:text-slate-300">{project.data.engines.unreal}</dd>
                </div>
              )
            }
          </dl>
        </div>

        {
          project.data.cardImage && (
            <img
              src={project.data.cardImage}
              alt={`${project.data.title} card image`}
              class="w-full rounded-xl border border-slate-200 object-cover dark:border-slate-700"
              loading="lazy"
            />
          )
        }
      </div>
    </header>

    <div
      class:list={[
        "surface",
        "space-y-6",
        "[&_h2]:text-2xl [&_h2]:font-bold",
        "[&_h3]:text-xl [&_h3]:font-semibold",
        "[&_p]:leading-7 [&_p]:text-slate-700 dark:[&_p]:text-slate-300",
        "[&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5",
        "[&_li]:text-slate-700 dark:[&_li]:text-slate-300",
        "[&_table]:w-full [&_table]:border-collapse [&_table]:overflow-hidden [&_table]:rounded-xl [&_table]:border [&_table]:border-slate-200 dark:[&_table]:border-slate-700",
        "[&_th]:bg-slate-100 [&_th]:px-3 [&_th]:py-2 [&_th]:text-left [&_th]:text-sm [&_th]:font-semibold dark:[&_th]:bg-slate-800",
        "[&_td]:border-t [&_td]:border-slate-200 [&_td]:px-3 [&_td]:py-2 [&_td]:text-sm dark:[&_td]:border-slate-700",
        "[&_a]:text-cyan-700 [&_a]:underline-offset-4 hover:[&_a]:underline dark:[&_a]:text-cyan-300",
        "[&_img]:w-full [&_img]:rounded-xl [&_img]:border [&_img]:border-slate-200 dark:[&_img]:border-slate-700",
        "[&_iframe]:aspect-video [&_iframe]:w-full [&_iframe]:rounded-xl [&_iframe]:border [&_iframe]:border-slate-200 dark:[&_iframe]:border-slate-700"
      ]}
    >
      <Content />
    </div>

    <section class="surface">
      <h2 class="text-2xl font-bold">Project links</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <a href={project.data.links.github} target="_blank" rel="noreferrer noopener">GitHub repository</a>
          {
            isWindowFracture && (
              <span class="text-slate-700 dark:text-slate-300">
                {" "}
                - Unity license required for commercial use and support.
              </span>
            )
          }
        </li>
        <li>
          <a href={project.data.links.docs} target="_blank" rel="noreferrer noopener">Documentation</a>
        </li>
        {
          hasAssetStore && (
            <li>
              <a href={project.data.links.assetStore} target="_blank" rel="noreferrer noopener">
                Unity Asset Store (placeholder)
              </a>
            </li>
          )
        }
      </ul>
    </section>
  </article>
</BaseLayout>
